# --- SIGA API : copier en .env et remplir. Ne jamais commiter .env ---
NODE_ENV=development
PORT=3000

# WhatsApp Cloud API (Meta for Developers > WhatsApp > Configuration de l'API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ID du compte WhatsApp Business (pour npm run meta:check)
WHATSAPP_WABA_ID=
# Jeton choisi librement (>= 16 caracteres), distinct du jeton d'acces
WHATSAPP_VERIFY_TOKEN=
# Parametres de l'app > De base > Cle secrete
META_APP_SECRET=
GRAPH_API_VERSION=v23.0

# MySQL de Laragon (root sans mot de passe par defaut). Creer la base "siga" ou laisser Prisma la creer
DATABASE_URL=mysql://root:@localhost:3306/siga
# Redis fourni par Laragon (Menu > Redis > Demarrer)
REDIS_URL=redis://localhost:6379

# Stockage des images : auto (S3 si STORAGE_ENDPOINT, sinon disque) | local | s3 | db (en base, pour Render)
STORAGE_BACKEND=auto
# Stockage S3 compatible (Cloudflare R2...). Vide = disque local STORAGE_LOCAL_DIR
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_LOCAL_DIR=./storage

# >= 32 caracteres : openssl rand -hex 32
HASH_SECRET=
# login:hashBcrypt separes par des virgules
ADMIN_USERS=
SENTRY_DSN=
ADMIN_WA_ID=

IMAGE_RETENTION_DAYS=30
SESSION_WINDOW_MINUTES=10
REVIEW_MODE=true
TERMS_VERSION=2026-11-v1
TERMS_URL=
FREE_TRIALS=5

# --- Extraction (OCR) ---
FORMATS_DIR=./config/formats
OCR_LANG=fra
OCR_CACHE_DIR=./tessdata
OCR_MIN_CONFIDENCE=60
OCR_UNREADABLE_CONFIDENCE=30
PROOF_SETTLE_SECONDS=8
MAX_IMAGE_BYTES=5000000

# --- Regles ---
MAX_TIME_GAP_MINUTES=10
FUTURE_TOLERANCE_MINUTES=5

# --- Offre et abonnements (FCFA) ---
FOUNDER_PRICE=2000
STANDARD_PRICE=3000
FOUNDER_SLOTS=20
MONTHLY_QUOTA=60
OVERAGE_PRICE=50
# Texte envoye au vendeur pour payer (numero Wave / OM du service)
PAYMENT_INSTRUCTIONS=

# --- Modeles de message Meta (a faire approuver) ---
TEMPLATE_VERDICT_READY=siga_verdict_pret
TEMPLATE_SUB_REMINDER=siga_rappel_abonnement

# --- Exploitation ---
RATE_LIMIT_PER_MINUTE=20

# --- Back-office (siga-admin) ---
# Dossier du back-office compile, servi sous /backoffice
ADMIN_UI_DIR=../siga-admin/dist
# Duree de la session admin (heures, glissante)
SESSION_TTL_HOURS=8

# --- Pages legales (/legal/*) ---
LEGAL_ENTITY_NAME=SIGA
LEGAL_CONTACT_EMAIL=
