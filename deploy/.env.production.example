# =====================================================================
# SIGA — configuration de PRODUCTION
# Copier en /opt/siga/.env (hors des dépôts Git), puis : chmod 600 /opt/siga/.env
#
# Règle de syntaxe (Docker Compose) :
#   - valeur contenant un $ (hash bcrypt…) → entre apostrophes 'comme ceci'
#   - valeur contenant des apostrophes ou des espaces → entre guillemets "comme ceci"
# DATABASE_URL et REDIS_URL sont fournis par docker-compose : ne pas les mettre ici.
# =====================================================================

# --- Adresse publique (sous-domaine DuckDNS ou ton domaine) ---
DOMAIN=siga-xxx.duckdns.org
# E-mail pour le certificat HTTPS Let's Encrypt (avis d'expiration)
ACME_EMAIL=toi@example.com

# --- MySQL (générer : openssl rand -hex 24) ---
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- WhatsApp Cloud API (mêmes valeurs que le .env local) ---
WHATSAPP_TOKEN=EAAhzLv3qO3sBS3pfMER22AKelP2K9VOmsX1x8xSuukEwLqElpJBvi3BDRDYPcIFw2hRmoeZCd8ZA0mNRXSrAZCkKl1nbuLxrIeDK64wtBemGyG1dI1ZBaExPNBZAIzT7rsmop1nmOGALeZCVVw3PW66jeFI93HUWSg2346CHNfbKAL6pM8dGBwdOvljrDKeQZDZD
WHATSAPP_PHONE_NUMBER_ID=1352151784658394
WHATSAPP_VERIFY_TOKEN=siga-df63f835ddc3c41fbfcb8fa82985f809173b04c642e7b541
META_APP_SECRET=9a96250c61b8882a2658509bfda8e07c
GRAPH_API_VERSION=v23.0

# --- Sécurité ---
# IMPORTANT : reprendre EXACTEMENT le HASH_SECRET du .env local, sinon les empreintes
# de références déjà enregistrées ne correspondent plus (détection des doublons).
HASH_SECRET=54da0b4594f075660d86000550475d2ef111461bd12885ca3ae39e9db173db93
# Ligne produite par : npm run admin:hash -- admin "mot-de-passe-long"   (entre apostrophes !)
ADMIN_USERS='admin:$2b$12$Tm8u6s2y2/Q4llyTBvRkR.O0zSiNaLm2t6LHslMvPI.7uubIkX6Eq'
# Ton numéro WhatsApp (sans +) pour recevoir les alertes administrateur
ADMIN_WA_ID=
SENTRY_DSN=

# --- Pages légales et conditions ---
LEGAL_ENTITY_NAME=SIGA
LEGAL_CONTACT_EMAIL=thicosylva@gmail.com
TERMS_URL=https://siga-xxx.duckdns.org/legal/cgu
TERMS_VERSION=2026-11-v1

# --- Offre ---
PAYMENT_INSTRUCTIONS="Envoie le montant par Wave au 77 XXX XX XX (nom : ...), puis écris HUMAIN avec la référence du paiement."
FREE_TRIALS=5
FOUNDER_PRICE=2000
STANDARD_PRICE=3000
FOUNDER_SLOTS=20
MONTHLY_QUOTA=60
OVERAGE_PRICE=50

# --- Fonctionnement ---
REVIEW_MODE=true
IMAGE_RETENTION_DAYS=30
SESSION_WINDOW_MINUTES=10
RATE_LIMIT_PER_MINUTE=20
SESSION_TTL_HOURS=8

# --- Modèles de message Meta (à faire approuver) ---
TEMPLATE_VERDICT_READY=siga_verdict_pret
TEMPLATE_SUB_REMINDER=siga_rappel_abonnement
