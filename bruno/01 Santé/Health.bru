meta {
  name: GET health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("base, file et stockage OK", function () {
    const b = res.getBody();
    expect(b.db).to.equal(true);
    expect(b.queue).to.equal(true);
    expect(b.storage).to.equal(true);
  });
}

docs {
  Contrôle de disponibilité (base MySQL, Redis, stockage). Public, sans donnée métier. 503 si un composant est en panne.
}
